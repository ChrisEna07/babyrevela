# =========================================================
# 1) Credenciales públicas del SDK web de Firebase
#    (Configuración de la consola de Firebase > Configuración del proyecto > Tus apps > Web)
# =========================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://TU-PROYECTO-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# =========================================================
# 2) PIN secreto del panel /admin
#    SOLO lo usa scripts/init-db.mjs para calcular el hash
#    SHA-256 que se guarda en la base. Nunca se envía al navegador.
# =========================================================
ADMIN_PIN=1234

# =========================================================
# 2b) Credenciales del súper administrador (/superadmin)
#     Default: nombre ChrizDev, PIN 3008
# =========================================================
SUPER_ADMIN_NAME=ChrizDev
SUPER_ADMIN_PIN=3008

# =========================================================
# 3) Credenciales de servidor (SOLO para scripts/init-db.mjs)
#    FIREBASE_SERVICE_ACCOUNT apunta al JSON descargado desde:
#    Consola de Firebase > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada
# =========================================================
FIREBASE_DATABASE_URL=https://TU-PROYECTO-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
